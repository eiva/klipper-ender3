[include mainsail.cfg]
# [include KlipperScreen.c]

# host MCU service is preinstalled and ready to use with:
[mcu CB1]
serial: /tmp/klipper_host_mcu

[mcu]
serial: /dev/serial/by-id/usb-Klipper_stm32h723xx_0B000D000951313339373836-if00

[printer]
kinematics: cartesian
max_velocity: 300
max_accel: 3000
max_z_velocity: 5
max_z_accel: 100

[force_move]
enable_force_move: true

[board_pins]
aliases:
    # EXP1 header
    EXP1_1=PE7, EXP1_2=PG1,
    EXP1_3=PG0, EXP1_4=PF15,
    EXP1_5=PF14, EXP1_6=PF13,    # Slot in the socket on this side
    EXP1_7=PF12, EXP1_8=PF11,
    EXP1_9=<GND>, EXP1_10=<5V>,

    # EXP2 header
    EXP2_1=PE13, EXP2_2=PE12,
    EXP2_3=PE15, EXP2_4=PE11,
    EXP2_5=PE10, EXP2_6=PE14,      # Slot in the socket on this side
    EXP2_7=PE8, EXP2_8=<RST>,
    EXP2_9=<GND>, EXP2_10=<NC>


[output_pin led]
pin: PC3
value: 1

[gcode_macro LED_ON]
gcode:
  SET_PIN PIN=led VALUE=0

[gcode_macro LED_OFF]
gcode:
  SET_PIN PIN=led VALUE=1

# Motor1
[stepper_x]
step_pin: PE6
dir_pin: !PE5 # Controls direction!
enable_pin: !PC14
microsteps: 16
rotation_distance: 40
position_endstop: 0
position_max: 235
homing_speed: 50
homing_retract_dist: 0
endstop_pin: ~PF4

[tmc2209 stepper_x]
uart_pin: PC13
#diag_pin: PF4 
run_current: 0.800
stealthchop_threshold: 999999

# Motor2
[stepper_y]
step_pin: PE2
dir_pin: !PE1
enable_pin: !PE4
microsteps: 16
rotation_distance: 40
position_endstop: 0
position_max: 235
homing_speed: 50
homing_retract_dist: 0
endstop_pin: ~PF3

[tmc2209 stepper_y]
uart_pin: PE3
#diag_pin: PF3
run_current: 0.800
stealthchop_threshold: 999999

# Motor3
[stepper_z]
step_pin: PB8
dir_pin: PB7
enable_pin: !PE0
microsteps: 16
rotation_distance: 8
endstop_pin: ~PF2
position_endstop: 0
position_max: 250
homing_speed: 8
homing_retract_dist: 0

[tmc2209 stepper_z]
uart_pin: PB9
#diag_pin: PF2
run_current: 0.650
stealthchop_threshold: 999999

# Motor 4 (Secondary Z)
[stepper_z1]
step_pin: PB4
dir_pin: PB3
enable_pin: !PB6
microsteps: 16
rotation_distance: 8
endstop_pin: ~PF2
#endstop_pin: ^PF2

[tmc2209 stepper_z1]
uart_pin: PB5
#diag_pin: PF2
run_current: 0.650
stealthchop_threshold: 999999

[z_tilt]
z_positions:
    2, 112
    247, 112
points:
    47, 112
    234, 112
speed: 120
horizontal_move_z: 8

[virtual_sdcard]
path: ~/printer_data/gcodes
[display_status]
[pause_resume]


# Motor5
[extruder]
max_extrude_only_distance: 100.0
step_pin: PG13
dir_pin: !PG12
enable_pin: !PG15
microsteps: 16
rotation_distance: 23.24127
nozzle_diameter: 0.4
filament_diameter: 1.75

min_extrude_temp: 15

heater_pin: PA0 # HE0
sensor_pin: PB0 # T0
sensor_type: EPCOS 100K B57560G104F

control: pid
pid_Kp: 21.527
pid_Ki: 1.063
pid_Kd: 108.982
min_temp: 0
max_temp: 250

[tmc2209 extruder]
uart_pin: PG14
run_current: 0.800
stealthchop_threshold: 999999

# Fan0
[fan]
pin: PF7

## Fan1
[heater_fan hotend_fan]
pin: PF9
heater: extruder
heater_temp: 50.0
fan_speed: 1.0

[filament_switch_sensor runout]
switch_pin: !PC15
pause_on_runout: False
runout_gcode:
  {action_respond_info("RUNOUT: Filament runout")}
  PAUSE
insert_gcode:
  {action_respond_info("RUNOUT: Filament inserted")}


[heater_bed]
heater_pin: PF5
sensor_pin: PB1 # TB 
sensor_type: EPCOS 100K B57560G104F
control: watermark
control: pid
# tuned for stock hardware with 50 degree Celsius target
pid_Kp: 54.027
pid_Ki: 0.770
pid_Kd: 948.182
min_temp: 0
max_temp: 130

[bed_screws]
screw1: 30.5, 37
screw2: 30.5, 207
screw3: 204.5, 207
screw4: 204.5, 37




